FROM node:20-alpine AS build

WORKDIR /app/frontend

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-update-notifier

COPY frontend /app/frontend

# Site key (publik) widget Cloudflare Turnstile. Nilai default sudah ada di
# frontend/.env.production (di-commit -- site key memang tampil di HTML, bukan
# rahasia). Build arg ini OPSIONAL: kalau diisi dari environment stack Dokploy
# ia menimpa lewat .env.production.local (prioritas lebih tinggi di Vite).
# Sengaja tidak pakai `ENV ...=$ARG` supaya arg kosong tidak menimpa
# .env.production dengan string kosong. Vite meng-inline var VITE_* saat build.
ARG VITE_TURNSTILE_SITE_KEY=""
RUN if [ -n "$VITE_TURNSTILE_SITE_KEY" ]; then \
      printf 'VITE_TURNSTILE_SITE_KEY=%s\n' "$VITE_TURNSTILE_SITE_KEY" > .env.production.local; \
    fi

RUN npm run build --no-update-notifier

FROM nginx:alpine

COPY deploy/nginx/etaseneu.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/frontend/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]


NASA_FIRMS_API_KEY=replace-me
DATABASE_URL=postgresql://user:password@host:5432/etaseneu
FRONTEND_ORIGIN=http://localhost:5173
# Wajib diisi buat lindungi endpoint admin (upload geojson, trigger sync,
# refresh cache, dst). Kosong = tolak semua request admin (fail closed).
ADMIN_API_KEY=replace-me
# Secret key (rahasia) widget Cloudflare Turnstile di halaman login.
# Kosong = verifikasi captcha dilewati, login jalan seperti biasa (fail-open).
# Diisi = login wajib mengirim token widget yang lolos verifikasi Cloudflare.
# Site key (publik) dipasang di frontend: VITE_TURNSTILE_SITE_KEY.
# Test key resmi Cloudflare (selalu lolos): 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=
SHP_DIR=../shp
CACHE_DIR=.cache
CACHE_TTL_HOURS=24
REQUEST_TIMEOUT_SECONDS=30

# Site key (publik) widget Cloudflare Turnstile di halaman login.
# Ambil dari dashboard Cloudflare > Turnstile > widget kamu.
# Kosong / tidak diisi = widget tidak muncul, login jalan seperti biasa.
# Pasangannya di backend: TURNSTILE_SECRET_KEY (rahasia, JANGAN ditaruh di sini).
# Test key resmi Cloudflare (selalu lolos, untuk coba tampilan tanpa akun):
#   VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
VITE_TURNSTILE_SITE_KEY=

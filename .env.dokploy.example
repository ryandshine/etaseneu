NASA_FIRMS_API_KEY=replace-me
DATABASE_URL=postgresql://user:password@host.docker.internal:5434/etaseneu
FRONTEND_ORIGIN=https://etaseneu.ditpps.com
# Wajib diisi buat lindungi endpoint admin (upload geojson, trigger sync,
# refresh cache, dst). Kosong = tolak semua request admin (fail closed).
ADMIN_API_KEY=replace-me
# Password gerbang login seluruh aplikasi (user tetap "admin", cuma satu
# akun bersama). Terpisah dari ADMIN_API_KEY di atas. Kosong = tolak semua
# percobaan login (fail closed).
APP_LOGIN_PASSWORD=replace-me
SHP_DIR=/app/shp
HOST_SHP_DIR=/etc/dokploy/data/etaseneu/shp
CACHE_DIR=.cache
CACHE_TTL_HOURS=1
REQUEST_TIMEOUT_SECONDS=30
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_HOURS=3
SCHEDULER_FIXED_HOURS=0,3,6,9,12,15,18,21
SCHEDULER_TIMEZONE=Asia/Jakarta
SCHEDULER_NEW_HOTSPOT_ALERT_THRESHOLD=1

# Luas kebakaran (MODIS MCD64A1 via Google Earth Engine). Kosong = fitur
# nonaktif. HOST_GEE_KEY_PATH menunjuk file JSON service account di host
# Dokploy (di-mount read-only ke GEE_SERVICE_ACCOUNT_KEY_PATH di container,
# sama seperti pola HOST_SHP_DIR/SHP_DIR).
GEE_SERVICE_ACCOUNT_EMAIL=replace-me@your-project.iam.gserviceaccount.com
GEE_SERVICE_ACCOUNT_KEY_PATH=/app/secrets/gee-service-account-key.json
HOST_GEE_KEY_PATH=/etc/dokploy/data/etaseneu/gee-service-account-key.json
GEE_PROJECT_ID=replace-me

# Auto-refresh burned area lewat Google Earth Engine (MCD64A1/VNP64A1).
# Default MATI -- sumber data burned area sudah dipindah ke rekap resmi
# KLHK. Ubah ke true di sini cuma kalau GEE mau diaktifkan lagi sebagai
# pelengkap; endpoint manual /api/burned-area/refresh tetap tersedia.
BURNED_AREA_SCHEDULER_ENABLED=false
BURNED_AREA_SCHEDULER_INTERVAL_HOURS=168
BURNED_AREA_SCHEDULER_LOOKBACK_MONTHS=3

# Direktori tempat admin men-SFTP file resmi KLHK "Areal Kebakaran Hutan dan
# Lahan" sebelum memicu POST /api/burned-area/refresh-klhk?file_name=...
# Sama pola dengan HOST_SHP_DIR/SHP_DIR -- read-only, bukan upload lewat HTTP.
KLHK_BURNED_AREA_DIR=/app/burned_area_klhk
HOST_KLHK_BURNED_AREA_DIR=/etc/dokploy/data/etaseneu/burned_area_klhk
